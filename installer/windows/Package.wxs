<?xml version="1.0" encoding="UTF-8"?>
<!--
  Self-contained PA-Converter MSI (WiX v4).
  Ships launchers + engine.zip. First-run Bootstrap enables WSL and provisions
  the native stack (Apache/PHP/MariaDB/RabbitMQ/Spark) — no Docker / Node / PAT.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?define ProductName = "PA-Converter" ?>
  <?define ProductVersion = "5.46.18" ?>
  <?define Manufacturer = "Tufail Ahmed Sheikh" ?>
  <?define UpgradeCode = "8F3E2A1B-4C5D-6E7F-8091-A2B3C4D5E6F7" ?>

  <Package
      Name="$(var.ProductName)"
      Manufacturer="$(var.Manufacturer)"
      Version="$(var.ProductVersion)"
      UpgradeCode="$(var.UpgradeCode)"
      Scope="perMachine"
      Language="1033">

    <!-- ASCII-only summary: Unicode dashes break CP1252 MSI summary on some PCs -->
    <SummaryInformation
        Description="PA-Converter - self-contained Expedition appliance for Windows (WSL2)"
        Manufacturer="$(var.Manufacturer)" />

    <MajorUpgrade
        DowngradeErrorMessage="A newer version of [ProductName] is already installed."
        Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Feature Id="Main" Title="$(var.ProductName)" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Finish setup now (enable WSL and start PA-Converter)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <CustomAction
        Id="StartBootstrap"
        Directory="INSTALLFOLDER"
        ExeCommand="cmd.exe /c Configure-PAConverter.cmd"
        Execute="immediate"
        Impersonate="yes"
        Return="asyncNoWait" />

    <UI>
      <Publish
          Dialog="ExitDialog"
          Control="Finish"
          Event="DoAction"
          Value="StartBootstrap"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- ProgramData\PA-Converter — self-contained appliance home -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="PA-Converter">
        <Directory Id="LibDir" Name="lib" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="PA-Converter" />
    </StandardDirectory>

  </Package>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="Cmp_EngineZip" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789001">
        <File Id="EngineZip" Source="payload\engine.zip" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_BootstrapPs1" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789002">
        <File Id="BootstrapPs1" Source="payload\Bootstrap-PAConverter.ps1" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_StartPs1" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789003">
        <File Id="StartPs1" Source="payload\Start-PAConverter.ps1" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_StopPs1" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789004">
        <File Id="StopPs1" Source="payload\Stop-PAConverter.ps1" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_StatusPs1" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789005">
        <File Id="StatusPs1" Source="payload\Status-PAConverter.ps1" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_ConfigureCmd" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789006">
        <File Id="ConfigureCmd" Source="payload\Configure-PAConverter.cmd" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_SetupBat" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789013">
        <File Id="SetupBat" Source="payload\SETUP.bat" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_StartCmd" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789007">
        <File Id="StartCmd" Source="payload\Start-PAConverter.cmd" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_StopCmd" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789008">
        <File Id="StopCmd" Source="payload\Stop-PAConverter.cmd" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_StatusCmd" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789009">
        <File Id="StatusCmd" Source="payload\Status-PAConverter.cmd" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_Readme" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789010">
        <File Id="ReadmeTxt" Source="payload\README.txt" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_VirtTxt" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789014">
        <File Id="VirtTxt" Source="payload\ENABLE-VIRTUALIZATION.txt" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_Module" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789011" Directory="LibDir">
        <File Id="PAModule" Source="payload\lib\PAConverter.psm1" KeyPath="yes" />
      </Component>
      <Component Id="Cmp_InstallReg" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789012">
        <RegistryValue Root="HKLM"
                       Key="Software\PA-Converter"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
        <RegistryValue Root="HKLM"
                       Key="Software\PA-Converter"
                       Name="Version"
                       Type="string"
                       Value="$(var.ProductVersion)" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="ApplicationShortcut" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789020" Directory="ProgramMenuDir">
      <Shortcut Id="ScConfigure"
                Name="1. Finish setup (first run)"
                Description="Enable WSL and provision PA-Converter"
                Target="[INSTALLFOLDER]SETUP.bat"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="ScStart"
                Name="2. Start PA-Converter"
                Description="Start Expedition and open the UI"
                Target="[INSTALLFOLDER]Start-PAConverter.cmd"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="ScStatus"
                Name="Status"
                Target="[INSTALLFOLDER]Status-PAConverter.cmd"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="ScStop"
                Name="Stop PA-Converter"
                Target="[INSTALLFOLDER]Stop-PAConverter.cmd"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="ScReadme"
                Name="README"
                Target="[INSTALLFOLDER]README.txt"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\PA-Converter"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
