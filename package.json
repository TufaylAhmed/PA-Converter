{
  "name": "@tufayl/pa-converter",
  "version": "5.46.47",
  "description": "PA-Converter — Palo Alto Expedition via Podman (macOS/Linux) or WSL native (Windows); no Docker Desktop",
  "license": "MIT",
  "bin": {
    "pa-converter": "bin/expedition.js",
    "expedition": "bin/expedition.js"
  },
  "files": [
    "bin",
    "databases",
    "app",
    "LICENSE",
    "README.md",
    "scripts",
    "native",
    "docker/docker-compose.yml",
    "docker/initdb",
    "docker/web",
    "docker/spark/README.md",
    ".dockerignore"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/expedition.js start",
    "stop": "node bin/expedition.js stop",
    "status": "node bin/expedition.js status",
    "logs": "node bin/expedition.js logs",
    "build": "node bin/expedition.js build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TufaylAhmed/PA-Converter.git"
  },
  "author": "Tufail Ahmed Sheikh <https://github.com/TufaylAhmed>",
  "keywords": [
    "expedition",
    "paloalto",
    "panw",
    "firewall-migration",
    "pa-converter"
  ]
}
